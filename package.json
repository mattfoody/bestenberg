{
  "name": "bestenberg",
  "private": true,
  "version": "0.0.0",
  "description": "AI-native visual editor on Gutenberg.",
  "author": "Matt Foody (https://mattfoody.com)",
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @bestenberg/editor build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm lint:js && pnpm lint:php",
    "lint:js": "eslint . && prettier --check .",
    "lint:php": "composer --working-dir=wp/plugin lint",
    "format": "prettier --write . && eslint . --fix",
    "test": "vitest run",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/bestenberg vendor/bin/phpunit",
    "test:e2e": "playwright test",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm stan && pnpm test:php && pnpm test:e2e",
    "stan": "composer --working-dir=wp/plugin stan",
    "env:start": "pnpm build && wp-env start",
    "env:stop": "wp-env stop",
    "env:reset": "wp-env destroy && wp-env start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@wordpress/env": "^10.20.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

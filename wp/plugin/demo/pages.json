{
  "imageBase": "https://demo.bestenberg.invalid/",
  "pages": [
    {
      "slug": "home",
      "title": "Morning Oven",
      "front": true,
      "content": "<!-- wp:bestenberg/section {\"bbId\":\"demo-home-0001\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.16\"}}}} -->\n<!-- wp:bestenberg/container {\"bbId\":\"demo-home-0002\",\"props\":{},\"style\":{\"base\":{\"width\":\"container.lg\"}}} -->\n<!-- wp:bestenberg/grid {\"bbId\":\"demo-home-0003\",\"props\":{},\"style\":{\"base\":{\"layout\":{\"display\":\"grid\",\"columns\":1,\"gap\":\"space.8\",\"align\":\"center\"}},\"desktop\":{\"layout\":{\"columns\":2,\"gap\":\"space.16\"}}}} -->\n<!-- wp:bestenberg/stack {\"bbId\":\"demo-home-0004\",\"props\":{},\"style\":{\"base\":{\"layout\":{\"display\":\"stack\",\"gap\":\"space.4\"}}}} -->\n<!-- wp:heading {\"level\":1,\"bestenberg\":{\"id\":\"demo-home-0005\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.4xl\"}}}}} -->\n<h1 class=\"wp-block-heading\">Bread worth waking up for</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-home-0006\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.lg\"},\"color\":\"color.muted\"}}}} -->\n<p>Sourdough, rye and seeded loaves, baked every morning at five in a wood-fired oven and gone by noon.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"bestenberg\":{\"id\":\"demo-home-0007\",\"style\":{\"base\":{\"margin\":{\"top\":\"space.4\"}}}}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-primary\",\"bestenberg\":{\"id\":\"demo-home-0008\"}} -->\n<div class=\"wp-block-button is-style-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"/bread-box/\">See the bread box</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n<!-- /wp:bestenberg/stack -->\n\n<!-- wp:image {\"bestenberg\":{\"id\":\"demo-home-0009\",\"style\":{\"base\":{\"radius\":\"radius.lg\",\"aspect\":\"4/3\"}}}} -->\n<figure class=\"wp-block-image\"><img src=\"https://demo.bestenberg.invalid/loaves.svg\" alt=\"Three loaves of bread on a shelf\"/></figure>\n<!-- /wp:image -->\n<!-- /wp:bestenberg/grid -->\n<!-- /wp:bestenberg/container -->\n<!-- /wp:bestenberg/section -->\n\n<!-- wp:bestenberg/section {\"bbId\":\"demo-home-0010\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.16\"}}}} -->\n<!-- wp:bestenberg/container {\"bbId\":\"demo-home-0011\",\"props\":{},\"style\":{\"base\":{\"width\":\"container.lg\"}}} -->\n<!-- wp:heading {\"bestenberg\":{\"id\":\"demo-home-0012\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.3xl\",\"align\":\"center\"},\"margin\":{\"bottom\":\"space.10\"}}}}} -->\n<h2 class=\"wp-block-heading\">Three things we never rush</h2>\n<!-- /wp:heading -->\n\n<!-- wp:bestenberg/grid {\"bbId\":\"demo-home-0013\",\"props\":{},\"style\":{\"base\":{\"layout\":{\"display\":\"grid\",\"columns\":1,\"gap\":\"space.6\"}},\"tablet\":{\"layout\":{\"columns\":3}}},\"locked\":\"none\"} -->\n<!-- wp:bestenberg/card {\"bbId\":\"demo-home-0014\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.6\"},\"radius\":\"radius.lg\",\"background\":\"color.surface\",\"border\":{\"width\":1,\"color\":\"color.border\"}}}} -->\n<!-- wp:heading {\"level\":3,\"bestenberg\":{\"id\":\"demo-home-0015\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.xl\"}}}}} -->\n<h3 class=\"wp-block-heading\">Slow dough</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-home-0016\",\"style\":{\"base\":{\"color\":\"color.muted\"}}}} -->\n<p>Every loaf rests for 24 hours. That is where the flavour and the crust come from.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:bestenberg/card -->\n\n<!-- wp:bestenberg/card {\"bbId\":\"demo-home-0017\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.6\"},\"radius\":\"radius.lg\",\"background\":\"color.surface\",\"border\":{\"width\":1,\"color\":\"color.border\"}}}} -->\n<!-- wp:heading {\"level\":3,\"bestenberg\":{\"id\":\"demo-home-0018\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.xl\"}}}}} -->\n<h3 class=\"wp-block-heading\">Local grain</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-home-0019\",\"style\":{\"base\":{\"color\":\"color.muted\"}}}} -->\n<p>Flour from two mills within forty kilometres, stone-ground the week we bake with it.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:bestenberg/card -->\n\n<!-- wp:bestenberg/card {\"bbId\":\"demo-home-0020\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.6\"},\"radius\":\"radius.lg\",\"background\":\"color.surface\",\"border\":{\"width\":1,\"color\":\"color.border\"}}}} -->\n<!-- wp:heading {\"level\":3,\"bestenberg\":{\"id\":\"demo-home-0021\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.xl\"}}}}} -->\n<h3 class=\"wp-block-heading\">Baked today</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-home-0022\",\"style\":{\"base\":{\"color\":\"color.muted\"}}}} -->\n<p>Nothing is frozen or kept overnight. What is left at closing goes to the food bank.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:bestenberg/card -->\n<!-- /wp:bestenberg/grid -->\n<!-- /wp:bestenberg/container -->\n<!-- /wp:bestenberg/section -->\n\n<!-- wp:bestenberg/section {\"bbId\":\"demo-home-0023\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.16\"},\"background\":\"color.surface-alt\"}}} -->\n<!-- wp:bestenberg/container {\"bbId\":\"demo-home-0024\",\"props\":{},\"style\":{\"base\":{\"width\":\"container.lg\"}}} -->\n<!-- wp:heading {\"bestenberg\":{\"id\":\"demo-home-0025\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.3xl\",\"align\":\"center\"},\"margin\":{\"bottom\":\"space.10\"}}}}} -->\n<h2 class=\"wp-block-heading\">What the neighbours say</h2>\n<!-- /wp:heading -->\n\n<!-- wp:bestenberg/grid {\"bbId\":\"demo-home-0026\",\"props\":{},\"style\":{\"base\":{\"layout\":{\"display\":\"grid\",\"columns\":1,\"gap\":\"space.6\"}},\"tablet\":{\"layout\":{\"columns\":3}}},\"locked\":\"none\"} -->\n<!-- wp:bestenberg/card {\"bbId\":\"demo-home-0027\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.6\"},\"radius\":\"radius.lg\",\"background\":\"color.surface\",\"shadow\":\"shadow.sm\"}}} -->\n<!-- wp:quote {\"bestenberg\":{\"id\":\"demo-home-0028\"}} -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-home-0029\"}} -->\n<p>The rye lasts a week on my counter. It never gets the chance.</p>\n<!-- /wp:paragraph --><cite>Ana, Saturday regular</cite></blockquote>\n<!-- /wp:quote -->\n<!-- /wp:bestenberg/card -->\n\n<!-- wp:bestenberg/card {\"bbId\":\"demo-home-0030\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.6\"},\"radius\":\"radius.lg\",\"background\":\"color.surface\",\"shadow\":\"shadow.sm\"}}} -->\n<!-- wp:quote {\"bestenberg\":{\"id\":\"demo-home-0031\"}} -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-home-0032\"}} -->\n<p>We switched our toast to their sourdough and people started asking where it is from.</p>\n<!-- /wp:paragraph --><cite>Marko, café owner</cite></blockquote>\n<!-- /wp:quote -->\n<!-- /wp:bestenberg/card -->\n\n<!-- wp:bestenberg/card {\"bbId\":\"demo-home-0033\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.6\"},\"radius\":\"radius.lg\",\"background\":\"color.surface\",\"shadow\":\"shadow.sm\"}}} -->\n<!-- wp:quote {\"bestenberg\":{\"id\":\"demo-home-0034\"}} -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-home-0035\"}} -->\n<p>Friday pickup is the best part of my week. The kids fight over the crust.</p>\n<!-- /wp:paragraph --><cite>Iva, bread box subscriber</cite></blockquote>\n<!-- /wp:quote -->\n<!-- /wp:bestenberg/card -->\n<!-- /wp:bestenberg/grid -->\n<!-- /wp:bestenberg/container -->\n<!-- /wp:bestenberg/section -->\n\n<!-- wp:bestenberg/section {\"bbId\":\"demo-home-0036\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.16\"},\"background\":\"color.primary\",\"color\":\"color.on-primary\"}}} -->\n<!-- wp:bestenberg/container {\"bbId\":\"demo-home-0037\",\"props\":{},\"style\":{\"base\":{\"width\":\"container.md\"}}} -->\n<!-- wp:heading {\"bestenberg\":{\"id\":\"demo-home-0038\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.3xl\",\"align\":\"center\"}}}}} -->\n<h2 class=\"wp-block-heading\">Fresh bread every Friday</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-home-0039\",\"style\":{\"base\":{\"font\":{\"align\":\"center\"},\"margin\":{\"top\":\"space.3\"}}}}} -->\n<p>Reserve your loaves once and pick them up warm. Pause or cancel any time.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"bestenberg\":{\"id\":\"demo-home-0040\",\"style\":{\"base\":{\"layout\":{\"justify\":\"center\"},\"margin\":{\"top\":\"space.6\"}}}}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-secondary\",\"bestenberg\":{\"id\":\"demo-home-0041\"}} -->\n<div class=\"wp-block-button is-style-secondary\"><a class=\"wp-block-button__link wp-element-button\" href=\"/bread-box/\">Choose a bread box</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n<!-- /wp:bestenberg/container -->\n<!-- /wp:bestenberg/section -->"
    },
    {
      "slug": "about",
      "title": "About",
      "front": false,
      "content": "<!-- wp:bestenberg/section {\"bbId\":\"demo-about-0001\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.16\"}}}} -->\n<!-- wp:bestenberg/container {\"bbId\":\"demo-about-0002\",\"props\":{},\"style\":{\"base\":{\"width\":\"container.lg\"}}} -->\n<!-- wp:bestenberg/grid {\"bbId\":\"demo-about-0003\",\"props\":{},\"style\":{\"base\":{\"layout\":{\"display\":\"grid\",\"columns\":1,\"gap\":\"space.8\",\"align\":\"center\"}},\"tablet\":{\"layout\":{\"columns\":2,\"gap\":\"space.12\"}}}} -->\n<!-- wp:image {\"bestenberg\":{\"id\":\"demo-about-0004\",\"style\":{\"base\":{\"radius\":\"radius.lg\",\"aspect\":\"4/3\"}}}} -->\n<figure class=\"wp-block-image\"><img src=\"https://demo.bestenberg.invalid/oven.svg\" alt=\"A brick oven with a loaf inside\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:bestenberg/stack {\"bbId\":\"demo-about-0005\",\"props\":{},\"style\":{\"base\":{\"layout\":{\"display\":\"stack\",\"gap\":\"space.4\"}}}} -->\n<!-- wp:heading {\"bestenberg\":{\"id\":\"demo-about-0006\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.3xl\"}}}}} -->\n<h2 class=\"wp-block-heading\">One oven, four bakers</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-about-0007\"}} -->\n<p>Morning Oven started in 2019 with a second-hand brick oven and a queue that did not fit on the pavement. We still bake the same six breads.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"bestenberg\":{\"id\":\"demo-about-0008\"}} -->\n<ul class=\"wp-block-list\"><!-- wp:list-item {\"bestenberg\":{\"id\":\"demo-about-0009\"}} -->\n<li>Wood-fired, every day except Sunday</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item {\"bestenberg\":{\"id\":\"demo-about-0010\"}} -->\n<li>Sourdough starter older than the bakery</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item {\"bestenberg\":{\"id\":\"demo-about-0011\"}} -->\n<li>Open from six until the shelves are empty</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n<!-- /wp:bestenberg/stack -->\n<!-- /wp:bestenberg/grid -->\n<!-- /wp:bestenberg/container -->\n<!-- /wp:bestenberg/section -->\n\n<!-- wp:bestenberg/section {\"bbId\":\"demo-about-0012\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.16\"}}}} -->\n<!-- wp:bestenberg/container {\"bbId\":\"demo-about-0013\",\"props\":{},\"style\":{\"base\":{\"width\":\"container.sm\"}}} -->\n<!-- wp:heading {\"bestenberg\":{\"id\":\"demo-about-0014\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.3xl\"}}}}} -->\n<h2 class=\"wp-block-heading\">Why so few breads</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-about-0015\",\"style\":{\"base\":{\"margin\":{\"top\":\"space.4\"}}}}} -->\n<p>A short list lets us get each one right. The sourdough, the rye and the seeded loaf are always there; three more change with the season.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-about-0016\",\"style\":{\"base\":{\"margin\":{\"top\":\"space.4\"}}}}} -->\n<p>If you miss one that is gone, tell us at the counter. Favourites tend to come back.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:bestenberg/container -->\n<!-- /wp:bestenberg/section -->"
    },
    {
      "slug": "bread-box",
      "title": "Bread box",
      "front": false,
      "content": "<!-- wp:bestenberg/section {\"bbId\":\"demo-bread-box-0001\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.16\"}}}} -->\n<!-- wp:bestenberg/container {\"bbId\":\"demo-bread-box-0002\",\"props\":{},\"style\":{\"base\":{\"width\":\"container.lg\"}}} -->\n<!-- wp:heading {\"bestenberg\":{\"id\":\"demo-bread-box-0003\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.3xl\",\"align\":\"center\"},\"margin\":{\"bottom\":\"space.10\"}}}}} -->\n<h2 class=\"wp-block-heading\">A standing order for good bread</h2>\n<!-- /wp:heading -->\n\n<!-- wp:bestenberg/grid {\"bbId\":\"demo-bread-box-0004\",\"props\":{},\"style\":{\"base\":{\"layout\":{\"display\":\"grid\",\"columns\":1,\"gap\":\"space.6\",\"align\":\"start\"}},\"tablet\":{\"layout\":{\"columns\":3}}},\"locked\":\"none\"} -->\n<!-- wp:bestenberg/card {\"bbId\":\"demo-bread-box-0005\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.8\",\"y\":\"space.8\"},\"radius\":\"radius.lg\",\"background\":\"color.surface\",\"border\":{\"width\":1,\"color\":\"color.border\"}}}} -->\n<!-- wp:heading {\"level\":3,\"bestenberg\":{\"id\":\"demo-bread-box-0006\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.lg\"},\"color\":\"color.muted\"}}}} -->\n<h3 class=\"wp-block-heading\">Small</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-bread-box-0007\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.4xl\",\"weight\":\"fontWeight.bold\"}}}}} -->\n<p>€9 a week</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"bestenberg\":{\"id\":\"demo-bread-box-0008\",\"style\":{\"base\":{\"margin\":{\"top\":\"space.4\",\"bottom\":\"space.6\"}}}}} -->\n<ul class=\"wp-block-list\"><!-- wp:list-item {\"bestenberg\":{\"id\":\"demo-bread-box-0009\"}} -->\n<li>One loaf of your choice</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item {\"bestenberg\":{\"id\":\"demo-bread-box-0010\"}} -->\n<li>Friday pickup</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons {\"bestenberg\":{\"id\":\"demo-bread-box-0011\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-secondary\",\"bestenberg\":{\"id\":\"demo-bread-box-0012\"}} -->\n<div class=\"wp-block-button is-style-secondary\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Choose Small</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n<!-- /wp:bestenberg/card -->\n\n<!-- wp:bestenberg/card {\"bbId\":\"demo-bread-box-0013\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.8\",\"y\":\"space.8\"},\"radius\":\"radius.lg\",\"background\":\"color.surface\",\"border\":{\"width\":2,\"color\":\"color.primary\"},\"shadow\":\"shadow.lg\"}}} -->\n<!-- wp:heading {\"level\":3,\"bestenberg\":{\"id\":\"demo-bread-box-0014\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.lg\"},\"color\":\"color.muted\"}}}} -->\n<h3 class=\"wp-block-heading\">Family</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-bread-box-0015\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.4xl\",\"weight\":\"fontWeight.bold\"}}}}} -->\n<p>€24 a week</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"bestenberg\":{\"id\":\"demo-bread-box-0016\",\"style\":{\"base\":{\"margin\":{\"top\":\"space.4\",\"bottom\":\"space.6\"}}}}} -->\n<ul class=\"wp-block-list\"><!-- wp:list-item {\"bestenberg\":{\"id\":\"demo-bread-box-0017\"}} -->\n<li>Three loaves</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item {\"bestenberg\":{\"id\":\"demo-bread-box-0018\"}} -->\n<li>One seasonal bread</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item {\"bestenberg\":{\"id\":\"demo-bread-box-0019\"}} -->\n<li>Friday or Saturday pickup</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons {\"bestenberg\":{\"id\":\"demo-bread-box-0020\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-primary\",\"bestenberg\":{\"id\":\"demo-bread-box-0021\"}} -->\n<div class=\"wp-block-button is-style-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Choose Family</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n<!-- /wp:bestenberg/card -->\n\n<!-- wp:bestenberg/card {\"bbId\":\"demo-bread-box-0022\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.8\",\"y\":\"space.8\"},\"radius\":\"radius.lg\",\"background\":\"color.surface\",\"border\":{\"width\":1,\"color\":\"color.border\"}}}} -->\n<!-- wp:heading {\"level\":3,\"bestenberg\":{\"id\":\"demo-bread-box-0023\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.lg\"},\"color\":\"color.muted\"}}}} -->\n<h3 class=\"wp-block-heading\">Café</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-bread-box-0024\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.4xl\",\"weight\":\"fontWeight.bold\"}}}}} -->\n<p>€79 a week</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"bestenberg\":{\"id\":\"demo-bread-box-0025\",\"style\":{\"base\":{\"margin\":{\"top\":\"space.4\",\"bottom\":\"space.6\"}}}}} -->\n<ul class=\"wp-block-list\"><!-- wp:list-item {\"bestenberg\":{\"id\":\"demo-bread-box-0026\"}} -->\n<li>Ten loaves, sliced if you like</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item {\"bestenberg\":{\"id\":\"demo-bread-box-0027\"}} -->\n<li>Delivery before seven</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item {\"bestenberg\":{\"id\":\"demo-bread-box-0028\"}} -->\n<li>Invoice once a month</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons {\"bestenberg\":{\"id\":\"demo-bread-box-0029\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-secondary\",\"bestenberg\":{\"id\":\"demo-bread-box-0030\"}} -->\n<div class=\"wp-block-button is-style-secondary\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Choose Café</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n<!-- /wp:bestenberg/card -->\n<!-- /wp:bestenberg/grid -->\n<!-- /wp:bestenberg/container -->\n<!-- /wp:bestenberg/section -->\n\n<!-- wp:bestenberg/section {\"bbId\":\"demo-bread-box-0031\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.16\"},\"background\":\"color.primary\",\"color\":\"color.on-primary\"}}} -->\n<!-- wp:bestenberg/container {\"bbId\":\"demo-bread-box-0032\",\"props\":{},\"style\":{\"base\":{\"width\":\"container.md\"}}} -->\n<!-- wp:heading {\"bestenberg\":{\"id\":\"demo-bread-box-0033\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.3xl\",\"align\":\"center\"}}}}} -->\n<h2 class=\"wp-block-heading\">Not sure which one?</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-bread-box-0034\",\"style\":{\"base\":{\"font\":{\"align\":\"center\"},\"margin\":{\"top\":\"space.3\"}}}}} -->\n<p>Come by on a Saturday and taste all six. The first loaf is on us.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"bestenberg\":{\"id\":\"demo-bread-box-0035\",\"style\":{\"base\":{\"layout\":{\"justify\":\"center\"},\"margin\":{\"top\":\"space.6\"}}}}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-secondary\",\"bestenberg\":{\"id\":\"demo-bread-box-0036\"}} -->\n<div class=\"wp-block-button is-style-secondary\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Find the bakery</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n<!-- /wp:bestenberg/container -->\n<!-- /wp:bestenberg/section -->"
    },
    {
      "slug": "contact",
      "title": "Contact",
      "front": false,
      "content": "<!-- wp:bestenberg/section {\"bbId\":\"demo-contact-0001\",\"props\":{},\"style\":{\"base\":{\"padding\":{\"x\":\"space.6\",\"y\":\"space.16\"}}}} -->\n<!-- wp:bestenberg/container {\"bbId\":\"demo-contact-0002\",\"props\":{},\"style\":{\"base\":{\"width\":\"container.sm\"}}} -->\n<!-- wp:heading {\"bestenberg\":{\"id\":\"demo-contact-0003\",\"style\":{\"base\":{\"font\":{\"size\":\"fontSize.3xl\"}}}}} -->\n<h2 class=\"wp-block-heading\">Come by</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-contact-0004\",\"style\":{\"base\":{\"margin\":{\"top\":\"space.4\"}}}}} -->\n<p>Morning Oven, 12 Mill Lane. Monday to Saturday from six in the morning until the bread is gone, usually around noon.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"bestenberg\":{\"id\":\"demo-contact-0005\",\"style\":{\"base\":{\"margin\":{\"top\":\"space.4\"}}}}} -->\n<p>For bread boxes and café orders write to <a href=\"mailto:hello@morningoven.example\">hello@morningoven.example</a> or call <a href=\"tel:+15550100\">555 0100</a>.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:bestenberg/container -->\n<!-- /wp:bestenberg/section -->"
    }
  ]
}

<?xml version="1.0"?>
<ruleset name="Bestenberg">
	<description>Coding standards for Bestenberg.</description>

	<file>bestenberg.php</file>
	<file>src</file>
	<file>tests</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="7.1"/>

	<rule ref="WordPress">
		<!-- PSR-4 file names (Plugin.php) instead of class-plugin.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Modern short array syntax is allowed. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="bestenberg"/>
				<element value="Bestenberg"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="bestenberg"/>
			</property>
		</properties>
	</rule>

	<!-- Tests: reading fixture files directly is fine. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Tests: relax documentation rules. -->
	<rule ref="Squiz.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>

{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "https://wordpress.org/wordpress-7.1.zip",
  "phpVersion": "8.3",
  "plugins": ["https://downloads.wordpress.org/plugin/woocommerce.latest-stable.zip"],
  "mappings": {
    "wp-content/plugins/bestenberg": "./wp/plugin",
    "wp-content/themes/bestenberg": "./wp/theme"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true
  },
  "lifecycleScripts": {
    "afterStart": "node bin/wp-env-setup.mjs"
  }
}

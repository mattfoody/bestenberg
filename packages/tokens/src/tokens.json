{
  "$description": "Bestenberg default design tokens (W3C DTCG format). Edit here; run `pnpm generate` to update theme.json, CSS variables and utilities.",
  "color": {
    "$type": "color",
    "primary": { "$value": "#1d4ed8", "$description": "Brand / primary actions" },
    "on-primary": { "$value": "#ffffff", "$description": "Text and icons on primary" },
    "accent": { "$value": "#f59e0b", "$description": "Highlights" },
    "surface": { "$value": "#ffffff", "$description": "Page background" },
    "surface-alt": { "$value": "#f4f4f5", "$description": "Alternate section background" },
    "on-surface": { "$value": "#18181b", "$description": "Default text" },
    "muted": { "$value": "#71717a", "$description": "Secondary text" },
    "border": { "$value": "#e4e4e7", "$description": "Dividers and borders" },
    "success": { "$value": "#16a34a" },
    "warning": { "$value": "#d97706" },
    "danger": { "$value": "#dc2626" }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" },
    "20": { "$value": "5rem" },
    "24": { "$value": "6rem" }
  },
  "fontSize": {
    "$type": "fluidDimension",
    "$description": "Fluid sizes: min at 320px viewport, max at 1280px.",
    "xs": { "$value": { "min": "0.75rem", "max": "0.8125rem" } },
    "sm": { "$value": { "min": "0.875rem", "max": "0.9375rem" } },
    "base": { "$value": { "min": "1rem", "max": "1.0625rem" } },
    "lg": { "$value": { "min": "1.125rem", "max": "1.25rem" } },
    "xl": { "$value": { "min": "1.25rem", "max": "1.5rem" } },
    "2xl": { "$value": { "min": "1.5rem", "max": "1.875rem" } },
    "3xl": { "$value": { "min": "1.875rem", "max": "2.25rem" } },
    "4xl": { "$value": { "min": "2.25rem", "max": "3rem" } },
    "5xl": { "$value": { "min": "2.75rem", "max": "3.75rem" } }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "serif": { "$value": ["ui-serif", "Georgia", "Cambria", "Times New Roman", "serif"] },
    "mono": {
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ]
    }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "lineHeight": {
    "$type": "number",
    "tight": { "$value": 1.15 },
    "snug": { "$value": 1.3 },
    "normal": { "$value": 1.5 },
    "relaxed": { "$value": 1.7 }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0" },
    "sm": { "$value": "0.25rem" },
    "md": { "$value": "0.5rem" },
    "lg": { "$value": "0.75rem" },
    "xl": { "$value": "1rem" },
    "full": { "$value": "9999px" }
  },
  "shadow": {
    "$type": "shadow",
    "none": { "$value": "none" },
    "sm": { "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)" },
    "md": { "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)" },
    "lg": { "$value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)" },
    "xl": { "$value": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)" }
  },
  "container": {
    "$type": "dimension",
    "sm": { "$value": "40rem" },
    "md": { "$value": "48rem" },
    "lg": { "$value": "64rem" },
    "xl": { "$value": "80rem" },
    "2xl": { "$value": "96rem" }
  },
  "breakpoint": {
    "$type": "dimension",
    "md": { "$value": "768px", "$description": "Tablet and up" },
    "lg": { "$value": "1024px", "$description": "Desktop and up" }
  }
}
